# --- Brand: the folder under brands/ with brand.json, the logos and the optional vault, prompts and map ---
# Relative to the repository root. Leave empty for the default pack.
BRAND_DIR=

# --- Buffer, one account (the original setup; used when there is no accounts.json) ---
# Create the key at https://publish.buffer.com/settings/api (keys expire, 30 days by default)
BUFFER_API_KEY=
# Optional. If your account has exactly one organization it is picked automatically.
BUFFER_ORG_ID=

# --- Buffer, several accounts (when accounts.json exists; copy accounts.example.json) ---
# One variable per account; accounts.json holds the variable NAME (keyEnv), never the key.
BUFFER_KEY_MAIN=
BUFFER_KEY_SECOND=

# --- Media: where Buffer fetches pictures and videos from ---
# Option 1, your own host. Public base URL of the batch's mediaRoot folder, no trailing slash needed.
# Example: https://media.example.com/example-launch
MEDIA_BASE_URL=

# Option 2, S3-compatible storage such as Hetzner Object Storage: node packages/engine/buffer.mjs upload <batch.json> --yes
# Endpoint is the host only; region is the location (fsn1, nbg1 or hel1); both come from the Hetzner console.
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_BUCKET=example-bucket
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public URL of the bucket's root, no trailing slash. The key (which starts with S3_PREFIX) is appended to it.
S3_PUBLIC_BASE_URL=https://example-bucket.fsn1.your-objectstorage.com
# Only this prefix needs public read in the bucket policy. Default: public/
S3_PREFIX=public/
