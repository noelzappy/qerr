{
  "name": "@vesk/web",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "predev": "prisma generate",
    "dev": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "prisma generate && tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/index.js",
    "migrate": "prisma migrate deploy",
    "pretest": "prisma generate",
    "test": "vitest run",
    "typecheck": "prisma generate && tsc -p tsconfig.test.json && tsc -p tsconfig.web.json"
  },
  "dependencies": {
    "@hono/node-server": "2.1.11",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@vesk/engine": "*",
    "better-auth": "1.7.27",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hono": "4.13.19",
    "lucide-react": "1.77.0",
    "nodemailer": "10.6.1",
    "pg": "8.23.1",
    "pg-boss": "12.38.2",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.6",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.1",
    "vaul": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "optionalDependencies": {
    "@vesk/ai": "*"
  }
}
