# Copy to .env for local development. Never commit real values.
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/vesk
APP_URL=http://localhost:3000
# 32+ random characters:  openssl rand -base64 48
BETTER_AUTH_SECRET=
# base64 of 32 random bytes:  openssl rand -base64 32
APP_ENCRYPTION_KEY=
# To rotate: set the new key above, give it the next version, and list the old one as version:key
APP_ENCRYPTION_KEY_VERSION=1
# APP_ENCRYPTION_KEY_OLD=1:base64key
BOOTSTRAP_ADMIN_EMAIL=
# Optional mail. Without SMTP the admin page shows invite and reset links to copy.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# local (a directory) or s3 (Hetzner Object Storage, uses the S3_* values below)
STORAGE_DRIVER=local
# S3_ENDPOINT= S3_REGION= S3_BUCKET= S3_ACCESS_KEY_ID= S3_SECRET_ACCESS_KEY= S3_PUBLIC_BASE_URL= S3_PREFIX=public/
# Extra origins allowed to write (the Vite dev server)
# TRUSTED_ORIGINS=http://localhost:5173
