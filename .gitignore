# Secrets and local files. .env and accounts.json are what apps/web/scripts/make-seed-secrets.mjs reads; channels.json,
# schema-cache.json and media/ are left over from the old command-line tool and stay ignored so they are never committed.
.env
.env.*
accounts.json
channels.json
schema-cache.json
media/
# Written at run time: the saved brand as a pack (state/brand/), the render lock and temporary renders (out/).
state/
out/
.DS_Store
packages/engine/design/assets/photos/*
!packages/engine/design/assets/photos/README.md
!packages/engine/design/assets/photos/CREDITS.md
packages/engine/design/assets/screens/*
!packages/engine/design/assets/screens/README.md
!packages/engine/design/assets/screens/SOURCES.md
review/
packages/engine/design/assets/brand/*
!packages/engine/design/assets/brand/SOURCES.md

node_modules/

# Dokploy environment block generated for pasting; never commit
deploy/*.env.local
